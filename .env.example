
NEXT_PUBLIC_SITE_URL=your hosted url

# https://resend.com/api-keys
RESEND_API_KEY=your_resend_key
# The verified "from" address Resend sends on your behalf
CONTACT_FROM_EMAIL=expected_email
CONTACT_TO_EMAIL=your_email

# Writing — Ghost Content API (blog.inovuslabs.org)
BLOG_API_URL=your_blog_here
BLOG_API_KEY=your_ghost_api_key_here
BLOG_AUTHOR=author

# SEO — search engine verification (optional; leave blank to skip the meta tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

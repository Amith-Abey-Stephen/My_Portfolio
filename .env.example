# ==========================================
# Amith Abey Stephen Portfolio — Environment Variables Template
# Copy this file to .env.local and populate the values.
# ==========================================

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://amith.site

# ------------------------------------------
# Contact Form (Resend)
# ------------------------------------------
# https://resend.com/api-keys
# In local development, leave RESEND_API_KEY blank to log submissions to console.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=hello@amith.site
CONTACT_TO_EMAIL=your_email@domain.com

# ------------------------------------------
# Writing / Blog Sync (Ghost Content API)
# ------------------------------------------
BLOG_API_URL=https://blog.inovuslabs.org
BLOG_API_KEY=
BLOG_AUTHOR=amith

# ------------------------------------------
# Search Engine Verification
# ------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ------------------------------------------
# Analytics & Tracking
# ------------------------------------------
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID (format: xxxxxxxxxx)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
